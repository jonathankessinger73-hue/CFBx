# CollegeFootballData.com API key (daily job only)
CFBD_API_KEY=

# Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=           # frontend-safe; the API uses it only to verify login tokens
SUPABASE_SERVICE_ROLE_KEY=   # backend only, never exposed to the frontend (unused so far)

# Postgres connection string for the Supabase project (Project Settings -> Database).
# Backend only. Used by the API, the seed/migrate scripts and the daily job.
DATABASE_URL=

# API server
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated frontend origins for CORS
