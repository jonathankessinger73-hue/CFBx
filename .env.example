# CollegeFootballData.com API key (daily job only)
CFBD_API_KEY=

# Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=           # frontend-safe; the API uses it only to verify login tokens
SUPABASE_SERVICE_ROLE_KEY=   # backend only, never exposed to the frontend (unused so far)

# Postgres connection string for the Supabase project (Project Settings -> Database).
# Backend only. Used by the API, the seed/migrate scripts and the daily job.
DATABASE_URL=
# Supabase's CA certificate (Database settings -> SSL Configuration -> Download
# certificate) so the connection is encrypted and verified. Path locally;
# in GitHub Actions put the file's contents in the DATABASE_CA_CERT secret.
DATABASE_CA_CERT_FILE=

# API server. By default it also serves the web app (web/) on the same origin,
# sending SUPABASE_URL + SUPABASE_ANON_KEY to browsers via /config.js.
PORT=3000
SERVE_WEB=true
PUBLIC_API_URL=        # leave empty when the web app is served by this API
ALLOWED_ORIGINS=       # comma-separated origins, only needed if the web app is hosted elsewhere
